# ================================================================
# PLATAFORMA CERTIFICADOS DIGITALES — .env.example
# Copiar a .env y completar con valores reales.
# NUNCA subir .env con secretos al repositorio Git.
# ================================================================

# =============================================
# BASE DE DATOS
# =============================================
DATABASE_URL="postgresql://certificados_user:TU_PASSWORD_SEGURA@localhost:5432/certificados_db?schema=public"
POSTGRES_DB=certificados_db
POSTGRES_USER=certificados_user
POSTGRES_PASSWORD=TU_PASSWORD_POSTGRESQL_SEGURA

# =============================================
# SEGURIDAD DE SESIONES
# Generar con: openssl rand -hex 64
# =============================================
SESSION_SECRET=CAMBIAR_POR_VALOR_ALEATORIO_DE_AL_MENOS_64_CARACTERES_HEX

# =============================================
# PEPPER DE CÓDIGOS SECRETOS DE CERTIFICADOS
# Este valor NUNCA debe cambiar en producción tras emitir certificados.
# Si se modifica, TODOS los códigos existentes dejarán de funcionar.
# Generar con: openssl rand -hex 32
# =============================================
CERTIFICATE_CODE_PEPPER=CAMBIAR_POR_VALOR_ALEATORIO_DE_AL_MENOS_32_BYTES_HEX

# =============================================
# CLAVE DE CIFRADO MFA TOTP SECRETS
# Generar con: openssl rand -hex 32
# =============================================
MFA_ENCRYPTION_KEY=CAMBIAR_POR_VALOR_ALEATORIO_DE_AL_MENOS_32_BYTES_HEX

# =============================================
# URLs
# =============================================
APP_URL=https://certificados.ejemplo.com
FRONTEND_URL=https://certificados.ejemplo.com
CORS_ORIGINS=https://certificados.ejemplo.com
PORT=4000
NODE_ENV=production

# =============================================
# ALMACENAMIENTO DE ARCHIVOS PDF PRIVADOS
# STORAGE_DRIVER: 'local' o 's3'
# =============================================
STORAGE_DRIVER=local
STORAGE_PATH=./storage/private/certificates
MAX_PDF_SIZE=10485760

# =============================================
# ALMACENAMIENTO S3-COMPATIBLE (Opcional)
# Completar solo si STORAGE_DRIVER=s3
# =============================================
S3_ENDPOINT=
S3_BUCKET=certificados-privados
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# =============================================
# ANTIVIRUS (ClamAV - Opcional)
# =============================================
ANTIVIRUS_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# =============================================
# RATE LIMITING
# =============================================
RATE_LIMIT_CERT_SEARCH_PER_MIN=5
RATE_LIMIT_CERT_SEARCH_PER_HOUR=30
RATE_LIMIT_LOGIN_PER_MIN=10

# =============================================
# BOOTSTRAP SUPERADMIN INICIAL (Temporal)
# Usar solo una vez al crear la primera cuenta.
# Eliminar luego de la creación.
# =============================================
INITIAL_SUPERADMIN_EMAIL=
INITIAL_SUPERADMIN_NAME=
INITIAL_SUPERADMIN_PASSWORD=
